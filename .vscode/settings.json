    "diffEditor.codeLens": true,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.renderSideBySide": true,
    "diffEditor.useInlineViewWhenSpaceIsLimited": false,
    "explorer.autoRevealExclude": {
        "*py_cache*": true,
        "*venv*": true
    },
    "explorer.excludeGitIgnore": true,
    "files.exclude": {
        ".mypy*": true,
        ".pytest.agent": true,
        ".pytest_cache": true,
        ".ruff_cache": true,
        ".vscode": true
    },
    "git.autofetch": true,
    "git.autofetchPeriod": 600,
    "git.blame.ignoreWhitespace": true,
    "git.blame.editorDecoration.enabled": true,
    "git.blame.statusBarItem.enabled": true,
    "git.blame.editorDecoration.disableHover": false,
    "git.blame.editorDecoration.template": "${authorName}, ${authorDateAgo} • ${subject}",
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.enableParallelIndexing": true,
    "python.analysis.includeVenvInWorkspaceSymbols": true,
    "python.analysis.referencesCodeLens": true,
    "pythonCodeLensLite.references.filterSelf": true,
    "pythonCodeLensLite.targets.imports.venv": true,
    "evenBetterToml.formatter.allowedBlankLines": 1,
    "evenBetterToml.formatter.indentEntries": true,
    "debug.toolBarLocation": "docked",
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontWeight": "normal",
    "chat.agent.maxRequests": 900,
    "chat.sessionSync.enabled": true,
    "github.copilot.advanced": {
        "authProvider": "github-enterprise"
    },
    "github.copilot.enable": {
        "*": true,
        "markdown": false,
        "plaintext": false,
        "scminput": false,
        "skill": false
    },
   
    "update.showReleaseNotes": false,
    "redhat.telemetry.enabled": false,
    "settingsSync.ignoredExtensions": [
        "vscode.cpp",
        "vscode.csharp",
        "vscode.clojure",
        "vscode.coffeescript",
        "vscode.fsharp",
        "vscode.swift",
        "vscode.shaderlab",
        "vscode.rust",
        "vscode.razor",
        "vscode.r",
        "vscode.pug",
        "vscode.ipynb",
        "vscode.emmet",
        "pkief.material-icon-theme",
        "ms-toolsai.datawrangler",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-explorer",
        "vscode-icons-team.vscode-icons"
    ],
    "chat.agentSessions.showExternal": "last7Days",
    "sqliteviewer.openReadonly": true,
    "chat.agent.sandbox.enabledWindows": "on",
    "[jsonc]": {
        "editor.quickSuggestions": {
            "strings": true
        },
        "editor.suggest.insertMode": "replace"
    },
    "workbench.activityBar.compact": true,
    "chat.viewSessions.orientation": "stacked",
    "chat.planAgent.defaultModel": "Auto (copilot)",
    "chat.viewProgressBadge.enabled": true
}
