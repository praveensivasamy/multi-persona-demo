    "editor.fontLigatures": true,
    "editor.fontVariations": true,
    "editor.minimap.enabled": false,
    "editor.renderControlCharacters": false,
    "editor.renderLineHighlight": "all",
    "editor.renderLineHighlightOnlyWhenFocus": true,
